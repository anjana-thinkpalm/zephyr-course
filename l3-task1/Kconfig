menu "LED Subsystem"

choice LED_BLINK_SLEEP_TIME
    prompt "LED blink sleep time"
    default LED_SLEEP_MEDIUM

config LED_SLEEP_SHORT
    bool "500ms (fast)"

config LED_SLEEP_MEDIUM
    bool "1s (medium)"

config LED_SLEEP_LONG
    bool "2s (slow)"

endchoice

menu "Advanced LED settings"

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION
    int "LED fade duration (ms)"
    default 500

menu "Expert settings"

config LED_DEBUGGING
    bool "Enable LED debugging"
    default n

config LED_CUSTOM_BLINK
    bool "Custom blink pattern"
    default n

endmenu

endmenu

endmenu