
mainmenu "LED Configuration"

menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y
    help
      Enable the LED subsystem.

if LED_SUBSYSTEM

choice LED_BLINK_SLEEP_TIME
    prompt "LED blink sleep time"
    default LED_BLINK_MEDIUM

config LED_BLINK_FAST
    bool "500ms (fast)"

config LED_BLINK_MEDIUM
    bool "1s (medium)"

config LED_BLINK_SLOW
    bool "2s (slow)"

endchoice

menuconfig ADVANCED_LED_SETTINGS
    bool "Advanced LED settings"
    default n
    help
      Enable advanced LED settings.

if ADVANCED_LED_SETTINGS

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION
    int "LED fade duration (ms)"
    range 0 10000
    default 500

menu "Expert settings"

config LED_DEBUG
    bool "Enable LED debugging"
    default n

config LED_CUSTOM_BLINK_PATTERN
    bool "Custom blink pattern"
    default n

endmenu

endif

endif
