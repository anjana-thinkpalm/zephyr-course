
menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"

if LED_SUBSYSTEM

choice LED_BLINK_SLEEP_TIME
    prompt "LED blink sleep time"
    default LED_SLEEP_MEDIUM

config LED_SLEEP_SHORT
    bool "500ms (fast)"

config LED_SLEEP_MEDIUM
    bool "1s (medium)"

config LED_SLEEP_LONG
    bool "2s (slow)"

endchoice

config LED_BLINK_SLEEP_MS
    int
    default 500 if LED_SLEEP_SHORT
    default 1000 if LED_SLEEP_MEDIUM
    default 2000 if LED_SLEEP_LONG

menuconfig LED_ADVANCED_SETTINGS
    bool "Advanced LED settings"

if LED_ADVANCED_SETTINGS

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION
    int "LED fade duration (ms)"
    range 0 5000
    default 500

endif

menu "Expert settings"
    visible if LED_ADVANCED_SETTINGS

config LED_DEBUGGING
    bool "Enable LED debugging"
    default n

config LED_CUSTOM_BLINK
    bool "Custom blink pattern"
    default n

endmenu

endif
